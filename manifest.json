{
  "name": "Ogoni Native Calendar",
  "short_name": "Ogoni Calendar",
  "description": "30-year native day calendar that works offline",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#2a1740",
  "theme_color": "#2a1740",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./index.html?go=today", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
